# Copy to .env.local. Use absolute paths for production services.
DATABASE_PATH=./data/lumera.sqlite
APP_URL=http://localhost:3000
# For local HTTP only. Use true behind HTTPS in production.
COOKIE_SECURE=false
# Set only when a trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
# Python service (frontend uses this URL for SSR and its transport proxy).
PYTHON_BACKEND_URL=http://127.0.0.1:8000
PYTHON_BACKEND_PORT=8000
# Optional executable override, e.g. D:/Jewellery/Jewellery/.venv/Scripts/python.exe
# PYTHON_EXECUTABLE=python

# WhatsApp: keep preview until business approval and setup are complete.
WHATSAPP_MODE=preview
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set a currently supported Graph API version from your Meta app dashboard (vXX.X).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 32+ random characters for external HTTP cron. Embedded Python scheduler needs no HTTP secret.
WHATSAPP_CRON_SECRET=
WHATSAPP_WORKER_ENABLED=true
# Optional comma-separated recipient allowlist for a Meta test number. Never redirects customer messages.
WHATSAPP_ALLOWED_RECIPIENTS=
# Optional, needed for automated template-list inspection in a future integration.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Custom Automation Center email delivery. Keep preview until sender/account are verified.
EMAIL_MODE=preview
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_PER_MINUTE=10
EMAIL_ALLOWED_RECIPIENTS=
# Optional independent worker secret; falls back to WHATSAPP_CRON_SECRET.
AUTOMATION_CRON_SECRET=
AUTOMATION_WORKER_ENABLED=true
