# Copy to .env.local. Use absolute paths for production services.
DATABASE_PATH=./data/lumera.sqlite
APP_URL=http://localhost:3000
# For local HTTP only. Use true behind HTTPS in production.
COOKIE_SECURE=false
# Set only when a trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# WhatsApp: keep preview until business approval and setup are complete.
WHATSAPP_MODE=preview
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set a currently supported Graph API version from your Meta app dashboard (vXX.X).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 32+ random characters for external cron. npm dev/start generate a process-local secret if blank.
WHATSAPP_CRON_SECRET=
WHATSAPP_WORKER_ENABLED=true
# Optional worker URL when public APP_URL differs from the local server listener.
# WHATSAPP_WORKER_URL=http://localhost:3000
# Optional comma-separated recipient allowlist for a Meta test number. Never redirects customer messages.
WHATSAPP_ALLOWED_RECIPIENTS=
# Optional, needed for automated template-list inspection in a future integration.
WHATSAPP_BUSINESS_ACCOUNT_ID=
