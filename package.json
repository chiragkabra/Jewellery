{
  "name": "lumera-jewellery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/with-whatsapp-worker.mjs dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/with-whatsapp-worker.mjs start",
    "typecheck": "tsc --noEmit",
    "photos": "python3 scripts/download-photos.py",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "whatsapp:worker": "node --env-file-if-exists=.env.local scripts/whatsapp-worker.mjs",
    "test:whatsapp": "node scripts/test-whatsapp.mjs",
    "whatsapp:check": "node --env-file-if-exists=.env.local scripts/check-whatsapp-account.mjs",
    "whatsapp:import": "node scripts/import-whatsapp-credentials.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "framer-motion": "^14.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  }
}
