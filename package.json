{
  "name": "lumera-jewellery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/run-project.mjs dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/run-project.mjs start",
    "typecheck": "tsc --noEmit",
    "photos": "python3 scripts/download-photos.py",
    "admin:create": "node scripts/python.mjs -m backend admin",
    "db:backup": "node scripts/python.mjs -m backend backup",
    "test:backend": "node scripts/python.mjs -m pytest backend/tests -v --junitxml=test-results/python.xml",
    "whatsapp:worker": "node scripts/python.mjs -m backend worker",
    "test:whatsapp": "node scripts/python.mjs -m pytest backend/tests/test_messaging.py -v",
    "whatsapp:check": "node scripts/python.mjs -m backend check-whatsapp",
    "whatsapp:import": "node scripts/python.mjs -m backend import-whatsapp",
    "test:automations": "node scripts/python.mjs -m pytest backend/tests/test_workflows.py -v",
    "automation:worker": "node scripts/python.mjs -m backend worker",
    "backend:dev": "node scripts/python.mjs -m backend serve",
    "test:python": "node scripts/python.mjs -m pytest backend/tests --cov=backend --cov-report=term-missing --cov-report=html:test-results/python-coverage --junitxml=test-results/python.xml",
    "test:integration": "node scripts/python.mjs scripts/test-project.py"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "framer-motion": "^14.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  }
}
