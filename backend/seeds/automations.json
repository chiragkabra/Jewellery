[
  {
    "name": "Purchase desk alert",
    "description": "Notify staff after a verified purchase; create a preparation task.",
    "definition": {
      "name": "Purchase desk alert",
      "trigger": "purchase_confirmed",
      "mode": "preview",
      "match": "all",
      "conditions": [],
      "cooldownMinutes": 0,
      "scheduleHour": 9,
      "scheduleMinute": 0,
      "steps": [
        {
          "id": "alert",
          "type": "staff_alert",
          "title": "Purchase {{reference}}",
          "body": "{{customerName}} has paid. Prepare the order.",
          "priority": "high"
        },
        {
          "id": "task",
          "type": "create_task",
          "title": "Prepare {{reference}}",
          "body": "Confirm packaging for {{customerName}}.",
          "minutes": 1440
        }
      ]
    }
  },
  {
    "name": "Low stock follow-up",
    "description": "Create an internal alert and replenishment task when stock falls to two or fewer.",
    "definition": {
      "name": "Low stock follow-up",
      "trigger": "inventory_low",
      "mode": "preview",
      "match": "all",
      "conditions": [],
      "cooldownMinutes": 60,
      "scheduleHour": 9,
      "scheduleMinute": 0,
      "steps": [
        {
          "id": "alert",
          "type": "staff_alert",
          "title": "Low stock: {{productName}}",
          "body": "Only {{stock}} pieces remain.",
          "priority": "high"
        },
        {
          "id": "task",
          "type": "create_task",
          "title": "Replenish {{productName}}",
          "body": "Review stock for {{reference}}.",
          "minutes": 1440
        }
      ]
    }
  },
  {
    "name": "Daily operations check",
    "description": "A daily staff reminder, scheduled in IST.",
    "definition": {
      "name": "Daily operations check",
      "trigger": "daily_schedule",
      "mode": "preview",
      "match": "all",
      "conditions": [],
      "cooldownMinutes": 0,
      "scheduleHour": 9,
      "scheduleMinute": 0,
      "steps": [
        {
          "id": "alert",
          "type": "staff_alert",
          "title": "Daily jewellery desk check",
          "body": "Review unpaid orders, due repairs, customer follow-ups and low stock.",
          "priority": "normal"
        }
      ]
    }
  },
  {
    "name": "Customer order email",
    "description": "Prepare a transactional order email; external delivery needs email configuration.",
    "definition": {
      "name": "Customer order email",
      "trigger": "order_received",
      "mode": "preview",
      "match": "all",
      "conditions": [],
      "cooldownMinutes": 0,
      "scheduleHour": 9,
      "scheduleMinute": 0,
      "steps": [
        {
          "id": "email",
          "type": "email",
          "title": "Order {{reference}} received",
          "body": "Hello {{customerName}}, we received order {{reference}} for {{amount}}. Our team will confirm fulfilment and arrange payment.",
          "recipient": "customer"
        }
      ]
    }
  }
]
